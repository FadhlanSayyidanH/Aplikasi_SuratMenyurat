APP_NAME="Surat Ditajenad"
# PENTING sebelum deploy ke server produksi (bukan sekadar dev/testing
# lokal): APP_ENV harus 'production' & APP_DEBUG harus 'false' -- kalau
# tidak, error apa pun akan menampilkan stack trace LENGKAP (termasuk query
# SQL & path server) ke siapa saja yang memicunya.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8900

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=surat_ditajenad_laravel
DB_USERNAME=root
DB_PASSWORD=

# Konfigurasi khusus sistem surat-menyurat (lihat config/suratapp.php)
AUTH_TOKEN_TTL_SECONDS=43200
FILE_TOKEN_TTL_SECONDS=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ONLYOFFICE_PORT=8801
# Port publik (proxy HTTPS Nginx) yang dipakai browser klien memuat
# Document Server -- CUMA dipakai saat APP_ENV=production, lihat komentar
# lengkap di config/suratapp.php.
ONLYOFFICE_PUBLIC_PORT=8443
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_HOST_GATEWAY=host.docker.internal:8900
CORS_EXTRA_ORIGIN=

# Target ukuran maksimal PER FILE lampiran setelah kompresi otomatis
# (dijamin tercapai untuk foto & PDF, usaha terbaik untuk docx/pptx/xlsx).
COMPRESS_TARGET_BYTES=1048576

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PENTING sebelum produksi: set 'true' begitu aplikasi diakses lewat HTTPS
# (mis. domain uji-carakabinum.web.id di CORS_EXTRA_ORIGIN), supaya cookie
# sesi tidak pernah terkirim lewat HTTP biasa. Kosongkan/hapus lagi kalau
# sedang dev lokal lewat HTTP biasa (http://localhost:8900).
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web Push (notifikasi ke notification bar HP/desktop meski browser
# tertutup) -- generate sepasang key baru per environment dengan
# `php artisan webpush:vapid`, JANGAN pakai punya environment lain.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
